<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MomentaryMomentos.ViewModels"
             xmlns:models="clr-namespace:MomentaryMomentos.Models"
             x:Class="MomentaryMomentos.Views.RelivePage"
             x:Name="Page"
             x:DataType="vm:ReliveViewModel"
             Title="Relive"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource WarmPageGradient}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="22,22,22,28" Spacing="18">

                <!-- Brand + title -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,4,0,4">
                    <Image Source="logo.png" WidthRequest="54" HeightRequest="54" Aspect="AspectFit" />
                    <Label Text="RELIVE"
                           FontSize="20" FontAttributes="Bold" CharacterSpacing="4"
                           TextColor="{StaticResource Ink}"
                           HorizontalOptions="Center" />
                    <Label Text="A little moment goes a long way."
                           FontSize="14" FontAttributes="Italic"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Keepsake / dice hero — one momento at a time, never a browsable grid.
                     The dice sits in the photo's own corner instead of a separate big CTA. -->
                <Border Style="{StaticResource Polaroid}" Margin="12,6,12,0">
                    <VerticalStackLayout Spacing="13">
                        <Grid HeightRequest="290">
                            <Border BackgroundColor="#DED8C1"
                                    StrokeShape="RoundRectangle 3"
                                    StrokeThickness="0">
                                <Grid>
                                    <BoxView>
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#A4A184" Offset="0" />
                                                <GradientStop Color="#74775F" Offset="1" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                    <Image Source="logo.png" WidthRequest="92" HeightRequest="92"
                                           Opacity="0.70"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Border WidthRequest="46" HeightRequest="46"
                                    BackgroundColor="#F0FFFDF7"
                                    Stroke="{StaticResource Accent}"
                                    StrokeThickness="2.5"
                                    StrokeShape="RoundRectangle 23"
                                    Padding="9"
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Margin="0,10,10,0">
                                <Border.Shadow>
                                    <Shadow Brush="#55D84C9A" Offset="0,3" Radius="10" Opacity="0.35" />
                                </Border.Shadow>
                                <ImageButton Source="dice.png"
                                             BackgroundColor="Transparent"
                                             Padding="0"
                                             Clicked="OnDiceClicked"
                                             SemanticProperties.Description="Roll the dice for a random momento" />
                            </Border>
                        </Grid>

                        <Label Text="Your next momento is waiting."
                               FontSize="19" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}" />
                        <Label Text="Tap the dice to surface one at random."
                               Style="{StaticResource Body}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Short transition after the dice is tapped -->
        <Grid IsVisible="{Binding IsChoosingMemory}" BackgroundColor="#CCF4EBD4" Padding="32">
            <Border Style="{StaticResource Polaroid}"
                    WidthRequest="270" HeightRequest="310"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="18">
                    <Image Source="dice.png" WidthRequest="84" HeightRequest="84" />
                    <ActivityIndicator IsRunning="{Binding IsChoosingMemory}" Color="{StaticResource Accent}" />
                    <Label Text="Rolling for a brighter moment…"
                           FontSize="17" FontAttributes="Italic"
                           TextColor="{StaticResource Ink}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
