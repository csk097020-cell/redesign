<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MomentaryMomentos.ViewModels"
             x:Class="MomentaryMomentos.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#050B1F" Offset="0" />
            <GradientStop Color="#0D1635" Offset="0.55" />
            <GradientStop Color="#110A2E" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="32,64,32,32" Spacing="0">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,0,0,40">
                <Grid HorizontalOptions="Center">
                    <Ellipse WidthRequest="130" HeightRequest="130" HorizontalOptions="Center" VerticalOptions="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                <GradientStop Color="#337C3AED" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="logo.png"
                           WidthRequest="88" HeightRequest="88"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
                <Label Text="Create Account" Style="{StaticResource H1}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="Start capturing your daily moments"
                       FontSize="14" TextColor="{StaticResource GlowCyan}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Glass Form Card -->
            <Frame Style="{StaticResource Card}" Padding="26">
                <VerticalStackLayout Spacing="4">

                    <Label Text="Full Name (optional)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <Frame Style="{StaticResource GlassInput}">
                        <Entry Text="{Binding FullName}" Placeholder="Jane Doe"
                               ReturnType="Next" BackgroundColor="Transparent" />
                    </Frame>

                    <Label Text="Email" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                    <Frame Style="{StaticResource GlassInput}">
                        <Entry Text="{Binding Email}" Placeholder="you@example.com"
                               Keyboard="Email" ReturnType="Next"
                               BackgroundColor="Transparent" />
                    </Frame>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,4">
                        <Label Text="Password" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding PasswordToggleText}"
                               TextColor="{StaticResource GlowCyan}" FontSize="13"
                               VerticalOptions="Center" Padding="12,6" Margin="0,-6"
                               SemanticProperties.Description="{Binding PasswordToggleDescription}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Frame Style="{StaticResource GlassInput}">
                        <Entry Text="{Binding Password}" Placeholder="At least 6 characters"
                               IsPassword="{Binding IsPasswordHidden}" ReturnType="Next"
                               BackgroundColor="Transparent" />
                    </Frame>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,4">
                        <Label Text="Confirm Password" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ConfirmPasswordToggleText}"
                               TextColor="{StaticResource GlowCyan}" FontSize="13"
                               VerticalOptions="Center" Padding="12,6" Margin="0,-6"
                               SemanticProperties.Description="{Binding ConfirmPasswordToggleDescription}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleConfirmPasswordVisibilityCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Frame Style="{StaticResource GlassInput}">
                        <Entry Text="{Binding ConfirmPassword}" Placeholder="Repeat password"
                               IsPassword="{Binding IsConfirmPasswordHidden}" ReturnType="Done"
                               BackgroundColor="Transparent" />
                    </Frame>

                    <Button Text="Create Account" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding SignUpCommand}" Margin="0,18,0,0" />

                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,22,0,0" Spacing="4">
                <Label Text="Already have an account?" Style="{StaticResource Body}" VerticalOptions="Center" />
                <Button Text="Sign In" Style="{StaticResource GhostBtn}"
                        FontAttributes="Bold"
                        Command="{Binding GoToLoginCommand}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource GlowCyan}"
                               IsVisible="{Binding IsBusy}" HorizontalOptions="Center" Margin="0,18,0,0" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding HasError}" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" Margin="0,8,0,0" FontSize="13" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
