<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MomentaryMomentos.ViewModels"
             x:Class="MomentaryMomentos.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Reset Password">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#050B1F" Offset="0" />
            <GradientStop Color="#0D1635" Offset="0.55" />
            <GradientStop Color="#110A2E" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="32,48" Spacing="16">
            <Label Text="🔑  Reset Password" Style="{StaticResource H2}" HorizontalOptions="Center" />
            <Label Text="Enter your email and we'll send a reset link."
                   Style="{StaticResource Body}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

            <!-- Success State -->
            <Border BackgroundColor="#2200E5A0"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Stroke="#5500E5A0"
                    Padding="20,16"
                    IsVisible="{Binding ResetSent}">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label Text="✅" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="Email Sent!" FontAttributes="Bold" FontSize="18"
                           TextColor="{StaticResource GlowGreen}" HorizontalOptions="Center" />
                    <Label Text="Check your inbox and follow the link to reset your password."
                           Style="{StaticResource Body}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Form -->
            <Frame Style="{StaticResource Card}" Padding="24"
                   IsVisible="{Binding ResetSent, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Email" Style="{StaticResource Caption}" />
                    <Frame Style="{StaticResource GlassInput}">
                        <Entry Text="{Binding EmailAddress}" Placeholder="you@example.com"
                               Keyboard="Email" BackgroundColor="Transparent" />
                    </Frame>
                    <Button Text="Send Reset Link" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding SendResetEmailCommand}" Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Frame>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource GlowCyan}"
                               IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding HasError}" HorizontalOptions="Center" FontSize="13" />

            <Button Text="← Back to Login" Style="{StaticResource GhostBtn}"
                    Command="{Binding BackToLoginCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
