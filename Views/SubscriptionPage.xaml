<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MomentaryMomentos.ViewModels"
             xmlns:svc="clr-namespace:MomentaryMomentos.Services"
             x:Class="MomentaryMomentos.Views.SubscriptionPage"
             x:DataType="vm:SubscriptionViewModel"
             Title="Subscription">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#050B1F" Offset="0" />
            <GradientStop Color="#0D1635" Offset="0.55" />
            <GradientStop Color="#110A2E" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="16">

            <Label Text="⭐  Upgrade to Premium" Style="{StaticResource H2}" />

            <!-- Current Status Card -->
            <Frame Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Current Plan" FontAttributes="Bold" FontSize="16"
                           TextColor="{StaticResource GlowCyan}" />
                    <Label Text="{Binding TierStatusMessage}" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Premium Benefits -->
            <Frame Style="{StaticResource Card}"
                   IsVisible="{Binding IsPremium, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Premium Benefits" FontAttributes="Bold" FontSize="16"
                           TextColor="{StaticResource GlowCyan}" />
                    <Label Text="✅  1,000 momentos" Style="{StaticResource Body}" />
                    <Label Text="✅  Access from any device" Style="{StaticResource Body}" />
                    <Label Text="✅  Automatic cloud backup" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Plans -->
            <CollectionView ItemsSource="{Binding AvailablePlans}"
                            IsVisible="{Binding IsPremium, Converter={StaticResource InverseBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:SubscriptionPlan">
                        <Frame Style="{StaticResource Card}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="16" />
                                <Label Grid.Column="1" Text="{Binding Price, StringFormat='${0:0.00}'}"
                                       FontAttributes="Bold" FontSize="18" TextColor="{StaticResource GlowCyan}"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Caption}" />
                                <Button Grid.Row="1" Grid.Column="1" Text="Subscribe"
                                        Style="{StaticResource PrimaryBtn}" HeightRequest="40"
                                        FontSize="13" Margin="0" Padding="12,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubscriptionViewModel}}, Path=PurchaseCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Already Premium — glass success card -->
            <Border BackgroundColor="#2200E5A0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1"
                    Stroke="#5500E5A0"
                    Padding="20,16"
                    IsVisible="{Binding IsPremium}">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="✨" FontSize="44" HorizontalOptions="Center" />
                    <Label Text="You're on Premium!" FontAttributes="Bold" FontSize="18"
                           TextColor="{StaticResource GlowGreen}" HorizontalOptions="Center" />
                    <Label Text="1,000 momentos, all yours." Style="{StaticResource Body}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Restore Purchases -->
            <Button Text="Restore Purchases" Style="{StaticResource SecondaryBtn}"
                    IsVisible="{Binding IsPremium, Converter={StaticResource InverseBoolConverter}}"
                    Command="{Binding RestorePurchasesCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource GlowCyan}"
                               IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding HasError}" HorizontalOptions="Center" FontSize="13" />

            <!-- Auto-renew disclosure + legal links.
                 App Store Review Guideline 3.1.2(c) requires the purchase flow to carry the
                 subscription title, length, price, and functional links to the privacy policy and
                 terms of use. Title/length/price are on the plan cards above; these are the rest.
                 Kept outside the IsPremium conditions so they stay reachable on both states. -->
            <BoxView HeightRequest="1" Color="#22FFFFFF" Margin="0,8,0,0" />

            <Label Style="{StaticResource Caption}"
                   Text="Subscriptions renew automatically unless cancelled at least 24 hours before the end of the current period. Your account is charged for renewal within 24 hours prior to the end of the current period. Manage or cancel anytime in Settings &gt; Apple Account &gt; Subscriptions." />

            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" Margin="0,4,0,8">
                <Label Text="Privacy Policy"
                       TextColor="{StaticResource GlowCyan}"
                       FontSize="13"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPrivacyPolicyCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Terms of Use"
                       TextColor="{StaticResource GlowCyan}"
                       FontSize="13"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTermsOfUseCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
