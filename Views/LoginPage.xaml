<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MomentaryMomentos.ViewModels"
             x:Class="MomentaryMomentos.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Aero deep-space gradient background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F4EBD4" Offset="0" />
            <GradientStop Color="#E3DCC0" Offset="0.56" />
            <GradientStop Color="#C8C8A5" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="32,64,32,32" Spacing="0">

            <!-- Logo / Hero -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,0,0,40">
                <!-- Glow halo behind logo -->
                <Grid HorizontalOptions="Center">
                    <Ellipse WidthRequest="160" HeightRequest="160" HorizontalOptions="Center" VerticalOptions="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                <GradientStop Color="#4400B4D8" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="logo.png"
                           WidthRequest="110" HeightRequest="110"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
                <Label Text="Momentary Momentos" Style="{StaticResource H1}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="Your life in 10-second moments"
                       FontSize="14" TextColor="{StaticResource OliveDark}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Connection Status Badge -->
            <Border BackgroundColor="#99FFFDF7"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1"
                    Stroke="{StaticResource GlassBorder}"
                    Padding="14,7"
                    HorizontalOptions="Center" Margin="0,0,0,28">
                <Label Text="{Binding ConnectionStatus}" FontSize="12"
                       TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
            </Border>

            <!-- Glass Form Card -->
            <Frame Style="{StaticResource Card}" Padding="26">
                <VerticalStackLayout Spacing="4">

                    <Label Text="Email" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <Frame Style="{StaticResource GlassInput}">
                        <Entry Text="{Binding Email}" Placeholder="you@example.com"
                               Keyboard="Email" ReturnType="Next"
                               BackgroundColor="Transparent" />
                    </Frame>

                    <!-- Label row doubles as the Show/Hide control. Padding on the toggle keeps the
                         tap target near the 44pt minimum despite the small type. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,4">
                        <Label Text="Password" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding PasswordToggleText}"
                               TextColor="{StaticResource OliveDark}" FontSize="13"
                               VerticalOptions="Center" Padding="12,6" Margin="0,-6"
                               SemanticProperties.Description="{Binding PasswordToggleDescription}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Frame Style="{StaticResource GlassInput}">
                        <Entry Text="{Binding Password}" Placeholder="••••••••"
                               IsPassword="{Binding IsPasswordHidden}" ReturnType="Done"
                               BackgroundColor="Transparent" />
                    </Frame>

                    <!-- Offline mode toggle -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,6">
                        <Label Text="Offline Mode" Style="{StaticResource Body}" VerticalOptions="Center" />
                        <Switch IsToggled="{Binding IsOfflineMode}" Grid.Column="1"
                                OnColor="{StaticResource GlowCyan}" VerticalOptions="Center"
                                Toggled="OnOfflineModeToggled" />
                    </Grid>

                    <!-- Sign In Button — Cyan→Violet gradient -->
                    <Button Text="Sign In" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding SignInCommand}" Margin="0,14,0,0" />

                    <!-- Forgot Password -->
                    <Button Text="Forgot Password?" Style="{StaticResource GhostBtn}"
                            Command="{Binding GoToForgotPasswordCommand}" />

                </VerticalStackLayout>
            </Frame>

            <!-- Register Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,22,0,0" Spacing="4">
                <Label Text="Don't have an account?" Style="{StaticResource Body}" VerticalOptions="Center" />
                <Button Text="Register" Style="{StaticResource GhostBtn}"
                        FontAttributes="Bold"
                        Command="{Binding GoToRegisterCommand}" />
            </HorizontalStackLayout>

            <!-- Busy Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource GlowCyan}"
                               IsVisible="{Binding IsBusy}" HorizontalOptions="Center" Margin="0,18,0,0" />

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding HasError}" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" Margin="0,8,0,0" FontSize="13" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
