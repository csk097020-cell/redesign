<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MomentaryMomentos.Views.SplashPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F4EBD4" Offset="0" />
            <GradientStop Color="#E3DCC0" Offset="0.56" />
            <GradientStop Color="#C8C8A5" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>

        <!-- Outer ambient glow — pulsing ring -->
        <Ellipse x:Name="GlowRingOuter"
                 WidthRequest="340" HeightRequest="340"
                 HorizontalOptions="Center" VerticalOptions="Center"
                 Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                    <GradientStop Color="#4400B4D8" Offset="0.0" />
                    <GradientStop Color="#2200B4D8" Offset="0.55" />
                    <GradientStop Color="Transparent"   Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Inner violet accent glow -->
        <Ellipse x:Name="GlowRingInner"
                 WidthRequest="220" HeightRequest="220"
                 HorizontalOptions="Center" VerticalOptions="Center"
                 Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                    <GradientStop Color="#337C3AED" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Logo + text stack — animates in -->
        <VerticalStackLayout x:Name="LogoStack"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="0"
                             Opacity="0">

            <!-- Logo image -->
            <Image x:Name="LogoImage"
                   Source="logo.png"
                   WidthRequest="120"
                   HeightRequest="120"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Scale="0.3" />

            <!-- App name -->
            <Label x:Name="AppTitle"
                   Text="Momentary Momentos"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#303127"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,0"
                   Opacity="0"
                   TranslationY="18" />

            <!-- Tagline with cyan glow color -->
            <Label x:Name="Tagline"
                   Text="Your life in 10-second moments"
                   FontSize="14"
                   TextColor="#5D6049"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,6,0,0"
                   Opacity="0"
                   TranslationY="12" />

        </VerticalStackLayout>

        <!-- Bottom loading indicator -->
        <VerticalStackLayout x:Name="LoadingIndicator"
                             VerticalOptions="End"
                             HorizontalOptions="Center"
                             Margin="0,0,0,60"
                             Opacity="0"
                             Spacing="10">
            <ActivityIndicator x:Name="Spinner"
                               Color="#D84C9A"
                               IsRunning="True"
                               WidthRequest="32"
                               HeightRequest="32"
                               HorizontalOptions="Center" />
            <Label Text="Loading your moments…"
                   FontSize="12"
                   TextColor="#74705E"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
