<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MomentaryMomentos.ViewModels"
             xmlns:models="clr-namespace:MomentaryMomentos.Models"
             x:Class="MomentaryMomentos.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False">

    <!--
        LIGHT MOMENTARY MOMENTOS HOME EXPERIMENT
        This page intentionally uses local resources so the rest of the app's
        dark theme remains untouched while we test a softer visual direction.
    -->
    <ContentPage.Resources>
        <Color x:Key="HomeInk">#2B2236</Color>
        <Color x:Key="HomeBody">#6F657B</Color>
        <Color x:Key="HomeMuted">#91889B</Color>
        <Color x:Key="HomePink">#EC4899</Color>
        <Color x:Key="HomePurple">#7C3AED</Color>
        <Color x:Key="HomeBlue">#6687A8</Color>
        <Color x:Key="HomeBorder">#E9DFF0</Color>
        <Color x:Key="HomeSurface">#FCFAFF</Color>
        <Color x:Key="HomeSoftPurple">#F4ECFF</Color>
        <Color x:Key="HomeSoftPink">#FFF0F7</Color>

        <Style x:Key="HomeTitle" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource HomeInk}" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="HomeCaption" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource HomeMuted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="HomeCard" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{StaticResource HomeSurface}" />
            <Setter Property="BorderColor" Value="{StaticResource HomeBorder}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HasShadow" Value="True" />
        </Style>

        <Style x:Key="HomeGhostButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource HomeSoftPurple}" />
            <Setter Property="TextColor" Value="{StaticResource HomePurple}" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HeightRequest" Value="38" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style x:Key="HomeSecondaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#FFFCFF" />
            <Setter Property="TextColor" Value="{StaticResource HomePurple}" />
            <Setter Property="BorderColor" Value="#DCCAEA" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HeightRequest" Value="62" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF9FC" Offset="0" />
            <GradientStop Color="#F7F4FB" Offset="0.52" />
            <GradientStop Color="#EEF3F8" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20,22,20,28" Spacing="0">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,22">
                    <Border BackgroundColor="White"
                            Stroke="#E8DAF0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            WidthRequest="54" HeightRequest="54"
                            Padding="5">
                        <Border.Shadow>
                            <Shadow Brush="#22000000" Offset="0,4" Radius="10" Opacity="0.16" />
                        </Border.Shadow>
                        <Image x:Name="LogoImage"
                               Source="logo.png"
                               WidthRequest="42"
                               HeightRequest="42"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label x:Name="TitleLabel"
                               Text="Momentary Momentos"
                               Style="{StaticResource HomeTitle}"
                               FontSize="25"
                               LineBreakMode="NoWrap"
                               MaxLines="1"
                               SizeChanged="OnTitleSizeChanged" />
                        <Label Text="Capture now. Rediscover later."
                               TextColor="{StaticResource HomeBody}"
                               FontSize="11" />
                        <Label Text="{Binding ConnectionStatus}"
                               Style="{StaticResource HomeCaption}"
                               Margin="0,2,0,0"
                               IsVisible="{Binding IsOffline}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            Text="?"
                            Style="{StaticResource HomeGhostButton}"
                            WidthRequest="38"
                            Padding="0"
                            FontSize="16"
                            FontAttributes="Bold"
                            Clicked="OnHelpClicked" />
                </Grid>

                <!-- Primary action: keep Capture visually dominant -->
                <Button Text="🎬   Capture a Momento"
                        Margin="0,0,0,12"
                        HeightRequest="76"
                        HorizontalOptions="Fill"
                        TextColor="White"
                        CornerRadius="24"
                        BorderWidth="0"
                        FontSize="19"
                        FontAttributes="Bold"
                        Clicked="OnCaptureClicked">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F04D9B" Offset="0" />
                            <GradientStop Color="#A855F7" Offset="0.55" />
                            <GradientStop Color="#7467C9" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="#557C3AED" Offset="0,8" Radius="18" Opacity="0.34" />
                    </Button.Shadow>
                </Button>

                <!-- Secondary actions are important, but no longer compete with Capture -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,0,0,22">
                    <Button Text="🎲  Relive"
                            Style="{StaticResource HomeSecondaryButton}"
                            Clicked="OnReliveClicked" />
                    <Button Grid.Column="1"
                            Text="＋  Upload"
                            Style="{StaticResource HomeSecondaryButton}"
                            Clicked="OnUploadClicked" />
                </Grid>

                <!-- Collection snapshot -->
                <Label Text="Your collection"
                       Style="{StaticResource HomeTitle}"
                       FontSize="17"
                       Margin="2,0,0,10" />

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="7" Margin="0,0,0,10">
                    <Frame Style="{StaticResource HomeCard}" Margin="0" Padding="8,10">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="1">
                            <Label Text="{Binding TotalMemories}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource HomePurple}"
                                   HorizontalOptions="Center" />
                            <Label Text="Momentos" Style="{StaticResource HomeCaption}"
                                   FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" Style="{StaticResource HomeCard}" Margin="0" Padding="8,10">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="1">
                            <Label Text="{Binding Favorites}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource HomePink}"
                                   HorizontalOptions="Center" />
                            <Label Text="Favorites" Style="{StaticResource HomeCaption}"
                                   FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="2" Style="{StaticResource HomeCard}" Margin="0" Padding="8,10">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="1">
                            <Label Text="{Binding ThisWeek}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="#4D8B83"
                                   HorizontalOptions="Center" />
                            <Label Text="This week" Style="{StaticResource HomeCaption}"
                                   FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="3" Style="{StaticResource HomeCard}" Margin="0" Padding="8,10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowCategoriesCommand}" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="1">
                            <Label Text="{Binding Categories}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="#B7791F"
                                   HorizontalOptions="Center" />
                            <Label Text="Tags" Style="{StaticResource HomeCaption}"
                                   FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Storage is quieter now; useful without becoming a whole card -->
                <Frame Style="{StaticResource HomeCard}" Margin="0,0,0,24" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="☁" FontSize="14" TextColor="{StaticResource HomeBlue}" />
                            <Label Text="{Binding StorageEstimate}"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource HomeBlue}" />
                            <Label Text="stored" Style="{StaticResource HomeCaption}" FontSize="10" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Trend}"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="#4D8B83"
                               VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Featured memory -->
                <Grid IsVisible="{Binding HasFeaturedMemory}" Margin="0,0,0,24">
                    <Frame Style="{StaticResource HomeCard}"
                           Margin="0" Padding="0"
                           BackgroundColor="#FFFCFF">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PlayFeaturedCommand}" />
                        </Frame.GestureRecognizers>

                        <Grid RowDefinitions="Auto,170,Auto">
                            <Grid ColumnDefinitions="*,Auto" Padding="16,14,16,8">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="A momento for you"
                                           TextColor="{StaticResource HomePurple}"
                                           FontSize="11" FontAttributes="Bold" />
                                    <Label Text="{Binding FeaturedSubtitle}"
                                           TextColor="{StaticResource HomeBody}"
                                           FontSize="11" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource HomeSoftPink}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="10,5"
                                        VerticalOptions="Center">
                                    <Label Text="▶  Play"
                                           TextColor="{StaticResource HomePink}"
                                           FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="14,0,14,0">
                                <Border StrokeShape="RoundRectangle 18"
                                        StrokeThickness="0"
                                        BackgroundColor="#ECE6F4"
                                        HeightRequest="170">
                                    <BoxView>
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#B8A5CD" Offset="0" />
                                                <GradientStop Color="#77648D" Offset="1" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                </Border>

                                <Border StrokeShape="RoundRectangle 18"
                                        StrokeThickness="0"
                                        IsVisible="{Binding FeaturedMemory.DisplayThumbnailSource,
                                                            Converter={StaticResource StringNotEmptyConverter}}">
                                    <Image Source="{Binding FeaturedMemory.DisplayThumbnailSource}"
                                           Aspect="AspectFill"
                                           HeightRequest="170" />
                                </Border>

                                <Border HorizontalOptions="Center" VerticalOptions="Center"
                                        BackgroundColor="#CCFFFFFF"
                                        StrokeShape="RoundRectangle 30"
                                        StrokeThickness="0"
                                        WidthRequest="58" HeightRequest="58">
                                    <Label Text="▶"
                                           TextColor="{StaticResource HomePurple}"
                                           FontSize="21"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Margin="4,0,0,0" />
                                </Border>

                                <Border HorizontalOptions="End" VerticalOptions="Start"
                                        BackgroundColor="#DDFDF8"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        Padding="7,4" Margin="8"
                                        IsVisible="{Binding FeaturedMemory.IsFavorite}">
                                    <Label Text="⭐" FontSize="15" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout Grid.Row="2" Padding="16,10,16,15" Spacing="5">
                                <Label Text="{Binding FeaturedMemory.Title}"
                                       Style="{StaticResource HomeTitle}"
                                       FontSize="15"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <FlexLayout BindableLayout.ItemsSource="{Binding FeaturedMemory.DisplayTags}"
                                                Wrap="Wrap" Direction="Row">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagInfo">
                                                <Border BackgroundColor="{Binding Color}"
                                                        StrokeShape="RoundRectangle 8"
                                                        StrokeThickness="0"
                                                        Padding="6,2" Margin="0,0,4,0">
                                                    <Label Text="{Binding DisplayLabel}"
                                                           TextColor="White"
                                                           FontSize="9"
                                                           FontAttributes="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding FeaturedMemory.CreatedAtLocal, StringFormat='{0:MMM d, yyyy}'}"
                                           TextColor="{StaticResource HomeMuted}"
                                           FontSize="10"
                                           VerticalOptions="End" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </Grid>

                <!-- Recent momentos -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,10">
                    <Label Text="Recent Momentos"
                           Style="{StaticResource HomeTitle}"
                           FontSize="17" />
                    <Button Grid.Column="1"
                            Text="Sign out"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource HomeMuted}"
                            FontSize="11"
                            HeightRequest="30"
                            Padding="8,0"
                            Command="{Binding SignOutCommand}" />
                </Grid>

                <Frame Style="{StaticResource HomeCard}"
                       IsVisible="{Binding HasNoMemories}"
                       Margin="0,0,0,16"
                       BackgroundColor="#FFFCFF">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8" Padding="12">
                        <Label Text="✦" FontSize="38" TextColor="{StaticResource HomePink}" HorizontalOptions="Center" />
                        <Label Text="Your first momento starts here"
                               Style="{StaticResource HomeTitle}"
                               FontSize="16"
                               HorizontalOptions="Center" />
                        <Label Text="Capture ten seconds now. Someday, it can find its way back to you."
                               TextColor="{StaticResource HomeBody}"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <CollectionView ItemsSource="{Binding RecentMemories}"
                                IsVisible="{Binding HasMemories}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Memory">
                            <Border Margin="0,5"
                                    Padding="0"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="1"
                                    Stroke="#E5D8EC"
                                    BackgroundColor="White">
                                <Border.Shadow>
                                    <Shadow Brush="#22000000" Offset="0,5" Radius="14" Opacity="0.14" />
                                </Border.Shadow>

                                <Grid HeightRequest="164">
                                    <BoxView>
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#8A779E" Offset="0" />
                                                <GradientStop Color="#4C3B60" Offset="1" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>

                                    <Image Source="icon_play.png"
                                           WidthRequest="44" HeightRequest="44"
                                           Opacity="0.28"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           InputTransparent="True" />

                                    <Image Source="{Binding DisplayThumbnailSource}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding DisplayThumbnailSource,
                                                               Converter={StaticResource StringNotEmptyConverter}}" />

                                    <BoxView VerticalOptions="End" HeightRequest="100">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#B0000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>

                                    <VerticalStackLayout VerticalOptions="End"
                                                         Padding="12,0,12,10" Spacing="3">
                                        <FlexLayout BindableLayout.ItemsSource="{Binding DisplayTags}"
                                                    Wrap="Wrap" Direction="Row">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:TagInfo">
                                                    <Border BackgroundColor="{Binding Color}"
                                                            StrokeShape="RoundRectangle 8"
                                                            StrokeThickness="0"
                                                            Padding="6,2" Margin="0,0,4,2">
                                                        <Label Text="{Binding DisplayLabel}"
                                                               TextColor="White"
                                                               FontSize="9"
                                                               FontAttributes="Bold" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                        <Label Text="{Binding Title}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Text="{Binding CreatedAtLocal, StringFormat='{0:MMM d, yyyy}'}"
                                               TextColor="#CCFFFFFF"
                                               FontSize="10" />
                                    </VerticalStackLayout>

                                    <Border HorizontalOptions="End" VerticalOptions="Start"
                                            BackgroundColor="#CCFFFFFF"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            Padding="7,4" Margin="8"
                                            IsVisible="{Binding IsFavorite}">
                                        <Label Text="⭐" FontSize="16" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="🏷  Manage Tags"
                        Style="{StaticResource HomeSecondaryButton}"
                        Margin="0,18,0,0"
                        HorizontalOptions="Fill"
                        HeightRequest="58"
                        FontSize="15"
                        Clicked="OnManageTagsClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
