<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══════════════════════════════════════════
         AERO GLASS STYLE SYSTEM
         ══════════════════════════════════════════ -->

    <!-- Base Label -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Entry -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ── PRIMARY BUTTON — Cyan → Violet gradient glow ── -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00B4D8" Offset="0" />
                    <GradientStop Color="#7C3AED" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#AA00B4D8" Offset="0,6" Radius="20" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── SECONDARY BUTTON — Glass outline with cyan glow ── -->
    <Style x:Key="SecondaryBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#2200B4D8" />
        <Setter Property="TextColor" Value="{StaticResource GlowCyan}" />
        <Setter Property="BorderColor" Value="{StaticResource GlowCyan}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ── ACCENT BUTTON — Pink → Violet gradient ── -->
    <Style x:Key="AccentBtn" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EC4899" Offset="0" />
                    <GradientStop Color="#8B5CF6" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#AA8B5CF6" Offset="0,4" Radius="14" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── DANGER BUTTON — Neon red ── -->
    <Style x:Key="DangerBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#AAFF4D6A" Offset="0,4" Radius="12" Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── GHOST BUTTON — Transparent text only ── -->
    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource GlowCyan}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ── GLASS CARD (Frame) ── -->
    <Style x:Key="Card" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="#CC0D1B3E" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="BorderColor" Value="#553B82F6" />
    </Style>

    <!-- ── GLASS INPUT FIELD WRAPPER ── -->
    <Style x:Key="GlassInput" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="#33162440" />
        <Setter Property="BorderColor" Value="#553B82F6" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <!-- ── TYPOGRAPHY ── -->
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- ── GLOW LABEL (cyan accent text) ── -->
    <Style x:Key="GlowLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource GlowCyan}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

</ResourceDictionary>
